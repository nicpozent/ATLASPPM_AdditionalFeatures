# Frontend build/runtime config. Copy to `.env` and fill for real Entra + API.
# Leave auth disabled (VITE_AUTH_ENABLED=false) to run the UI with no backend.

VITE_AUTH_ENABLED=false

# Microsoft Entra ID (set when VITE_AUTH_ENABLED=true)
VITE_AUTH_TENANT_ID=
VITE_AUTH_CLIENT_ID=
# The API resource. TWO app registrations: api://atlas-ppm (the API's App ID URI).
# ONE app registration exposing its own API: use the app's GUID (no api://) — an
# app requesting api://<itself>/.default is rejected by Entra (AADSTS90009).
VITE_API_AUDIENCE=api://atlas-ppm
# Scope suffix. ".default" for a two-app setup; a named scope (e.g. access_as_user)
# for a single app that exposes its own API.
VITE_API_SCOPE=.default
# Idle-logout policy: sign an authenticated session out after this many minutes
# of inactivity (default 15; clamped to 1–480). Only applies when auth is enabled.
VITE_AUTH_IDLE_MINUTES=15

# API base (same-origin in prod via nginx; dev uses the Vite proxy below)
VITE_API_BASE=/api/v1
# Where `vite dev` proxies /api to (your local backend), only used in dev
VITE_API_PROXY=http://localhost:8081

# --- Docker Compose (see docs/DOCKER.md) --------------------------------------
# The VITE_* values above are also read as build args by `docker compose build`,
# and Auth__* are passed to the API for Entra token validation.
# Host ports the frontend is published on (HTTPS is primary; HTTP redirects to it)
HTTPS_PORT=443
HTTP_PORT=80
# PostgreSQL credentials for the `db` service + the API connection string
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
# Preload the demo portfolio? Off = production starts empty and fills with real
# data. Set true only for a walkthrough on a fresh (empty) database.
SEED_DEMO_DATA=false

# Microsoft Graph — powers Teams → "Sync from Entra". Use the ATLAS PPM *API*
# app registration (confidential client): its client id + a client secret, with
# the GroupMember.Read.All APPLICATION permission (admin-consented). NOT the Web
# SPA registration. Leave empty to keep manual group add. The compose forwards
# these to the API as Graph__TenantId / Graph__ClientId / Graph__ClientSecret.
# In production, prefer a Docker secret for GRAPH_CLIENT_SECRET (see docs/secrets.md).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Optional: only sync groups assigned to the "Atlas Team Group" app role.
# Set to that app role's id (GUID); leave empty to sync all groups assigned to
# the Atlas Enterprise Application.
GRAPH_SYNC_APP_ROLE_ID=

# --- Jira Cloud (pull-only) ----------------------------------------------------
# Powers Integrations → Jira "Test connection" and the per-project pull sync
# (sprints/epics/issues/backlog). Create an Atlassian API token (id.atlassian.com
# → Security → API tokens) for a service account with Browse Projects on the
# target projects. Auth is HTTP Basic using EMAIL:TOKEN. Leave empty to keep Jira
# dormant. In production, prefer a Docker secret for JIRA_API_TOKEN (see
# docs/secrets.md). Guide: docs/jira-setup.md
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: story-points custom-field id, if your site differs from the default
# (Jira Cloud's usual "Story point estimate"). Forwarded to the API as
# Jira__StoryPointsField.
JIRA_STORY_POINTS_FIELD=customfield_10016
# The sync pulls the full field set plus comments and attached files by default.
# Set to false to skip mirroring comments / downloading files, or lower the
# per-file size cap (bytes; default 25 MiB). Forwarded as Jira__* to the API.
JIRA_IMPORT_COMMENTS=true
JIRA_IMPORT_ATTACHMENTS=true
JIRA_MAX_ATTACHMENT_BYTES=26214400

# --- Azure DevOps (connector) -------------------------------------------------
# Powers Integrations → Azure DevOps: "Test connection", project discovery /
# import (maps an ADO project to a new/existing Atlas project), and full
# work-item sync — iterations → sprints, work items → epics/tasks, idempotent by
# ADO id, with changed-since delta pulls (Project.LastAdoSync) run on a
# background queue/worker. Create a Personal Access Token (dev.azure.com → User
# settings → Personal access tokens) scoped to the org with Project & Team (Read)
# and Work Items (Read). Auth is HTTP Basic using an EMPTY username and the PAT
# as the password. ADO_ORG accepts a bare org name ("contoso") or the full
# https://dev.azure.com/contoso URL. Leave empty to keep the connector dormant.
# In production, prefer a Docker secret for ADO_PAT (see docs/secrets.md). Guide:
# docs/azure-devops-setup.md. Forwarded to the API as
# AzureDevOps__Organization / AzureDevOps__Pat.
ADO_ORG=
ADO_PAT=
# Optional: max work items pulled per project (WIQL ceiling; default 20000). The
# sync runs in the background, so this is the real bound, not an anti-timeout cap.
# Forwarded to the API as AzureDevOps__MaxWorkItems.
ADO_MAX_WORK_ITEMS=20000
