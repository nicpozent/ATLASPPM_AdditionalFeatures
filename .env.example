# Frontend build/runtime config. Copy to `.env` and fill for real Entra + API.
# Leave auth disabled (VITE_AUTH_ENABLED=false) to run the UI with no backend.

VITE_AUTH_ENABLED=false

# Microsoft Entra ID (set when VITE_AUTH_ENABLED=true)
VITE_AUTH_TENANT_ID=
VITE_AUTH_CLIENT_ID=
# The API resource. TWO app registrations: api://atlas-ppm (the API's App ID URI).
# ONE app registration exposing its own API: use the app's GUID (no api://) — an
# app requesting api://<itself>/.default is rejected by Entra (AADSTS90009).
VITE_API_AUDIENCE=api://atlas-ppm
# Scope suffix. ".default" for a two-app setup; a named scope (e.g. access_as_user)
# for a single app that exposes its own API.
VITE_API_SCOPE=.default

# API base (same-origin in prod via nginx; dev uses the Vite proxy below)
VITE_API_BASE=/api/v1
# Where `vite dev` proxies /api to (your local backend), only used in dev
VITE_API_PROXY=http://localhost:8081

# --- Docker Compose (see docs/DOCKER.md) --------------------------------------
# The VITE_* values above are also read as build args by `docker compose build`,
# and Auth__* are passed to the API for Entra token validation.
# Host ports the frontend is published on (HTTPS is primary; HTTP redirects to it)
HTTPS_PORT=443
HTTP_PORT=80
# PostgreSQL credentials for the `db` service + the API connection string
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
